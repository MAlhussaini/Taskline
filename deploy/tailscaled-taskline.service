[Unit]
Description=Taskline private Tailscale identity
Documentation=https://tailscale.com/docs/
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/sbin/tailscaled --state=/var/lib/tailscale-taskline/tailscaled.state --statedir=/var/lib/tailscale-taskline --socket=/run/tailscale-taskline/tailscaled.sock --port=0 --tun=userspace-networking
Restart=on-failure
RestartSec=3
RuntimeDirectory=tailscale-taskline
RuntimeDirectoryMode=0755
StateDirectory=tailscale-taskline
StateDirectoryMode=0700
Type=notify

[Install]
WantedBy=multi-user.target
